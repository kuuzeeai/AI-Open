<?xml version="1.0" encoding="utf-8"?>
<!-- OpenCode as the phone's assistant (Android only): the side button's session, no hotword. -->
<voice-interaction-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:recognitionService="ai.opencode.app.assistant.OpenCodeRecognitionService"
    android:sessionService="ai.opencode.app.assistant.OpenCodeAssistantSessionService"
    android:settingsActivity="ai.opencode.app.MainActivity"
    android:supportsAssist="true"
    android:supportsLaunchVoiceAssistFromKeyguard="false"
    android:supportsLocalInteraction="false" />
